{
  "name": "@mhellams/mth-store",
  "version": "0.2.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:cov": "vitest --coverage",
    "test:debug": "node --inspect node_modules/.bin/vitest  --no-file-parallelism"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rslib/core": "^0.13.3",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.18.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "type-fest": "^5.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "private": false,
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
